# Copy to .env and fill secrets. CHARTER_PIN is a hash (not a secret) — must match charter.md.
# Never commit real keys. When Doctor emits needs_secret: add the named KEY here, then
# reload via src/secrets.ts reloadAndRetryParked() (or restart host + retry parked wip).
# Optional POST /api/secrets/reload is server-owned — not required for MVP.

CHARTER_PIN=9b0284fd84ee8385a81c0bce3407ea1d5c8580f8815089cdf1ac6e5b91462d8d

# Pi branch Talk/Forge (see docs/PI_DELTA.md). Prefer OPENROUTER; avoid :free models.
PI_MODEL=openrouter/openai/gpt-4o-mini
OPENROUTER_API_KEY=

# SPEC also names OPENAI_API_KEY (llm:call / upstream Talk). Optional if using OpenRouter only.
OPENAI_API_KEY=

# Search / integrations (grow keys as needed)
SEARCH_PROVIDER=brave
BRAVE_API_KEY=
TAVILY_API_KEY=
# APIFY_TOKEN=
BLAND_API_KEY=

# Voice — WAVs for denied/install/broken; live TTS + Instant Voice Clone for voice-note beat
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JgMBD2CZ0VSURf6BgyOt

# Runtime
JUDGE_MODE=0
OFFLINE=0
PORT=8787
