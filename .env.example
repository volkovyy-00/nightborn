# Copy to .env and fill secrets. CHARTER_PIN is a hash (not a secret) — must match charter.md.
# Never commit real keys. When Doctor emits needs_secret: add the named KEY here, then
# reload via src/secrets.ts reloadAndRetryParked() (or restart host + retry parked wip).
# Optional POST /api/secrets/reload is server-owned — not required for MVP.

CHARTER_PIN=9b0284fd84ee8385a81c0bce3407ea1d5c8580f8815089cdf1ac6e5b91462d8d

# Pi branch Talk (see docs/PI_DELTA.md). Prefer OPENROUTER; avoid :free models.
PI_MODEL=openrouter/openai/gpt-4o-mini
OPENROUTER_API_KEY=

# Talk + Forge planner: pi (default, OpenRouter via Pi tools) or cursor (Cursor SDK Agent.prompt → JSON).
# PLANNER=cursor requires CURSOR_API_KEY (Dashboard → Integrations). Host still owns Doctor/Warden/Install.
PLANNER=pi
# PLANNER_CURSOR_MODEL=composer-2.5
# CURSOR_API_KEY=

# Forge-only override when PLANNER=pi: pi (default) or cursor (local `agent` CLI + `agent login`; no API key).
FORGE_BACKEND=pi
# FORGE_AGENT_BIN=agent
# FORGE_AGENT_MODEL=
# Forge debug dumps (prompt/stdout/tools) under staging/forge_debug/ + surgery pointers. Default on; set 0 to disable.
# FORGE_DEBUG=1
# Opt-in: skip Forge LLM and use canned scaffolds (listings VDP scrapers). Default off.
# FORGE_SCAFFOLD_FIRST=1

# SPEC also names OPENAI_API_KEY (llm:call / upstream Talk). Optional if using OpenRouter only.
OPENAI_API_KEY=

# Search / integrations (grow keys as needed)
SEARCH_PROVIDER=brave
BRAVE_API_KEY=
TAVILY_API_KEY=
# APIFY_TOKEN=
# Composio Tool Router (host-only — never granted to skill children). Node >= 22.22.3.
# Marketplace access (e.g. Apify Actors) via request_access + Connect Link; not Broker APIFY_TOKEN.
COMPOSIO_API_KEY=
# COMPOSIO_USER_ID=nightborn
BLAND_API_KEY=
# Only number the host will dial (query phones are redirected here). Required for notify:phone.
BLAND_DEMO_PHONE_NUMBER=

# Voice — WAVs for denied/install/broken; live TTS + Instant Voice Clone for voice-note beat
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JgMBD2CZ0VSURf6BgyOt

# Runtime
JUDGE_MODE=0
OFFLINE=0
PORT=8787
