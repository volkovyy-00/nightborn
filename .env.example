# Copy to .env and fill secrets. CHARTER_PIN is a hash (not a secret) — must match charter.md.

CHARTER_PIN=f2e9ef12c2fa6cdfdd91ee35a2dedf21a00c509083795e2cfb67016475ad2200

# Pi branch Talk/Forge (see docs/PI_DELTA.md). Prefer OPENROUTER; avoid :free models.
PI_MODEL=openrouter/openai/gpt-4o-mini
OPENROUTER_API_KEY=

# SPEC also names OPENAI_API_KEY (llm:call / upstream Talk). Optional if using OpenRouter only.
OPENAI_API_KEY=

# Search — frozen brave; tavily only as fallback
SEARCH_PROVIDER=brave
BRAVE_API_KEY=
TAVILY_API_KEY=
# APIFY_TOKEN=   # only after c4-reuse-forged + Go

# Voice (pre-rendered WAVs; ID frozen §18 #4)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JgMBD2CZ0VSURf6BgyOt

# Runtime
JUDGE_MODE=0
OFFLINE=0
PORT=8787
