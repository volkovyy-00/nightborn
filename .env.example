# Copy to .env and fill the two keys. CHARTER_PIN is a hash (not a secret); it must match charter.md (SPEC §6).
CHARTER_PIN=6e4aa8f0b4e5c9bf65c938eddb05818762490e1fc8c969779228ecca31f9f19b

# LLM: Pi SDK 0.75.x over OpenRouter (SPEC §10). Talk + forge models.
OPENROUTER_API_KEY=
PI_MODEL=openrouter/anthropic/claude-haiku-4.5
PI_MODEL_FORGE=openrouter/anthropic/claude-haiku-4.5

# Search: Brave news + web. The only key a hand can ever get (Broker, SPEC §9).
BRAVE_API_KEY=

# Runtime
FORGE_MODE=recipe
JUDGE_MODE=0
OFFLINE=0
PORT=8787

# Voice: pre-rendered WAVs in public/voice/ (SPEC §18 #5) + live TTS of Talk's VOICE: line (§10, §18 #14).
# Server only; never brokered to a hand. Empty → spoken replies stay silent.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JgMBD2CZ0VSURf6BgyOt

# NB_HOSTS is internal (skill child env only) — never set it here.
