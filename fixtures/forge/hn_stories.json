{
  "match": ["hacker news", "hn stories", "hn "],
  "visited": ["hn.algolia.com"],
  "recipe": {
    "name": "hn_stories",
    "purpose": "Hacker News stories matching a search query (Algolia API).",
    "endpoint": "json",
    "queryPattern": null,
    "site": null,
    "urlPattern": "https://hn.algolia.com/api/v1/search?query={query}&tags=story&hitsPerPage=5",
    "itemsPath": "hits",
    "matchInput": null,
    "map": { "title": "{title}", "url": "{url}", "snippet": null, "date": "{created_at}" },
    "inputs": [
      { "name": "query", "type": "string", "format": "text", "required": true, "description": "Search words as the user wrote them" }
    ],
    "example": { "query": "Rust" }
  }
}
